[Unit]
Description=Avian web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avian
Group=avian
WorkingDirectory=/opt/avian
EnvironmentFile=/etc/avian/avian.env
ExecStart=/opt/avian/avian
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avian

[Install]
WantedBy=multi-user.target
