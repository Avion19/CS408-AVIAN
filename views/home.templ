package views

templ Home() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link href="/static/css/output.css" rel="stylesheet"/>
			<title>GoTH Hello World</title>
		</head>

		<body class="min-h-screen flex items-center justify-center bg-slate-950">
			<main class="rounded-xl border border-slate-700 bg-slate-900 p-10 shadow-xl">
				<h1 class="text-5xl font-bold text-white">
					Hello World
				</h1>

				<p class="mt-4 text-slate-400">
					Built with Go, Echo, Templ, and Tailwind CSS.
				</p>
			</main>
		</body>
	</html>
}
